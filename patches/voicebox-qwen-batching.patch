+"""Regression tests for slide-atomic adaptive TTS batching."""
+
+import unittest
+
+import numpy as np
+
+from backend.models import AtomicGenerationChunk
+from backend.routes.generations import _generate_atomic_batch_adaptive
+
+
+class MemoryLimitedBackend:
+    def __init__(self):
+        self.calls = []
+
+    async def generate_batch(
+        self,
+        texts,
+        voice_prompt,
+        language,
+        seed,
+        instruct,
+    ):
+        self.calls.append((list(texts), list(instruct)))
+        if len(texts) > 2:
+            raise RuntimeError("CUDA out of memory")
+        return [
+            np.array([float(len(text))], dtype=np.float32)
+            for text in texts
+        ], 24_000
+
+
+class AtomicBatchTests(unittest.IsolatedAsyncioTestCase):
+    async def test_oom_bisection_keeps_items_and_instructions_atomic(self):
+        backend = MemoryLimitedBackend()
+        items = [
+            AtomicGenerationChunk(
+                id=f"slide-{index:02d}",
+                text=f"complete slide {index}",
+                instruct=f"pace {index}",
+            )
+            for index in range(1, 5)
+        ]
+
+        audio, sample_rate = await _generate_atomic_batch_adaptive(
+            backend,
+            items,
+            {"preset_voice_id": "ExampleSpeaker"},
+            "en",
+            None,
+        )
+
+        self.assertEqual(sample_rate, 24_000)
+        self.assertEqual(
+            [texts for texts, _ in backend.calls],
+            [
+                [item.text for item in items],
+                [item.text for item in items[:2]],
+                [item.text for item in items[2:]],
+            ],
+        )
+        self.assertEqual(
+            [prompts for _, prompts in backend.calls],
+            [
+                [item.instruct for item in items],
+                [item.instruct for item in items[:2]],
+                [item.instruct for item in items[2:]],
+            ],
+        )
+        self.assertEqual(
+            [segment.tolist() for segment in audio],
+            [[float(len(item.text))] for item in items],
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
