+@router.post("/generate/atomic-batch")
+async def generate_atomic_batch(
+    data: models.AtomicBatchGenerationRequest,
+    db: Session = Depends(get_db),
+):
+    """Generate several complete slide texts in one GPU batch.
+
+    The ZIP response contains one WAV per request item. CUDA OOM recovery may
+    bisect the list internally, but it never splits an item's text.
+    """
+    from ..backends import (
+        ensure_model_cached_or_raise,
+        get_tts_backend_for_engine,
+        load_engine_model,
+    )
+
+    item_ids = [item.id for item in data.chunks]
+    if len(set(item_ids)) != len(item_ids):
+        raise HTTPException(status_code=400, detail="Atomic batch chunk ids must be unique")
+
+    profile = await profiles.get_profile(data.profile_id, db)
+    if not profile:
+        raise HTTPException(status_code=404, detail="Profile not found")
+    try:
+        profiles.validate_profile_engine(profile, data.engine)
+    except ValueError as error:
+        raise HTTPException(status_code=400, detail=str(error)) from error
+
+    await ensure_model_cached_or_raise(data.engine, data.model_size)
+    await load_engine_model(data.engine, data.model_size)
+    backend = get_tts_backend_for_engine(data.engine)
+    voice_prompt = await profiles.create_voice_prompt_for_profile(
+        data.profile_id,
+        db,
+        engine=data.engine,
+    )
+
+    audio_items, sample_rate = await _generate_atomic_batch_adaptive(
+        backend,
+        data.chunks,
+        voice_prompt,
+        data.language,
+        data.seed,
+    )
+    if len(audio_items) != len(data.chunks):
+        raise RuntimeError(
+            f"Atomic batch returned {len(audio_items)} WAVs for {len(data.chunks)} items"
+        )
+    if sample_rate <= 0:
+        raise RuntimeError(f"Atomic batch returned invalid sample rate {sample_rate}")
+
+    manifest_items = []
+    archive_buffer = io.BytesIO()
+    with zipfile.ZipFile(
+        archive_buffer,
+        mode="w",
+        compression=zipfile.ZIP_STORED,
+    ) as archive:
+        for index, (item, audio) in enumerate(zip(data.chunks, audio_items), start=1):
+            if len(audio) == 0:
+                raise RuntimeError(f"Atomic batch returned empty audio for {item.id}")
+            if data.normalize:
+                from ..utils.audio import normalize_audio
+
+                audio = normalize_audio(audio)
+            filename = f"{index:03d}-{re.sub(r'[^A-Za-z0-9._-]', '-', item.id)}.wav"
+            wav_bytes = tts.audio_to_wav_bytes(audio, sample_rate)
+            archive.writestr(filename, wav_bytes)
+            manifest_items.append(
+                {
+                    "id": item.id,
+                    "filename": filename,
+                    "duration_seconds": round(len(audio) / sample_rate, 6),
+                    "sample_rate": sample_rate,
+                }
+            )
+        archive.writestr(
+            "manifest.json",
+            json.dumps(
+                {
+                    "format": "voicebox.atomic-tts-batch.v1",
+                    "item_count": len(manifest_items),
+                    "items": manifest_items,
+                },
+                ensure_ascii=False,
+                indent=2,
+            )
+            + "\n",
+        )
+
+    return Response(
+        content=archive_buffer.getvalue(),
+        media_type="application/zip",
+        headers={"Content-Disposition": 'attachment; filename="atomic-speech.zip"'},
+    )
+
