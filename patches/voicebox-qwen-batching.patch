+import numpy as np
+import pytest
+
+from backend.utils.chunked_tts import generate_chunked
+
+
+class BatchBackend:
+    def __init__(self):
+        self.batch_calls = []
+        self.single_calls = []
+
+    async def generate(self, text, voice_prompt, language, seed, instruct):
+        self.single_calls.append(text)
+        return np.array([float(len(text))], dtype=np.float32), 24_000
+
+    async def generate_batch(self, texts, voice_prompt, language, seed, instruct):
+        self.batch_calls.append(list(texts))
+        return [np.array([float(len(text))], dtype=np.float32) for text in texts], 24_000
+
+
+class MemoryLimitedBatchBackend(BatchBackend):
+    async def generate_batch(self, texts, voice_prompt, language, seed, instruct):
+        self.batch_calls.append(list(texts))
+        if len(texts) > 2:
+            raise RuntimeError("CUDA out of memory")
+        return [np.array([float(len(text))], dtype=np.float32) for text in texts], 24_000
+
+
+@pytest.mark.asyncio
+async def test_generate_chunked_batches_supported_backend_in_order():
+    backend = BatchBackend()
+
+    audio, sample_rate = await generate_chunked(
+        backend,
+        "One. Two. Three.",
+        {},
+        max_chunk_chars=6,
+        crossfade_ms=0,
+        batch_size=2,
+    )
+
+    assert sample_rate == 24_000
+    assert backend.batch_calls == [["One.", "Two."]]
+    assert backend.single_calls == ["Three."]
+    assert audio.tolist() == [4.0, 4.0, 6.0]
+
+
+@pytest.mark.asyncio
+async def test_generate_chunked_does_not_batch_when_seed_is_requested():
+    backend = BatchBackend()
+
+    await generate_chunked(
+        backend,
+        "One. Two. Three.",
+        {},
+        seed=10,
+        max_chunk_chars=6,
+        crossfade_ms=0,
+        batch_size=2,
+    )
+
+    assert backend.batch_calls == []
+    assert backend.single_calls == ["One.", "Two.", "Three."]
+
+
+@pytest.mark.asyncio
+async def test_generate_chunked_halves_oom_batch_before_using_serial_generation():
+    backend = MemoryLimitedBatchBackend()
+
+    audio, sample_rate = await generate_chunked(
+        backend,
+        "One. Two. Three. Four.",
+        {},
+        max_chunk_chars=6,
+        crossfade_ms=0,
+        batch_size=4,
+    )
+
+    assert sample_rate == 24_000
+    assert backend.batch_calls == [["One.", "Two.", "Three.", "Four."], ["One.", "Two."], ["Three.", "Four."]]
+    assert backend.single_calls == []
+    assert audio.tolist() == [4.0, 4.0, 6.0, 5.0]
