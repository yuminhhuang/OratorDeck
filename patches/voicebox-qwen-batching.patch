+async def _generate_atomic_batch_adaptive(
+    backend,
+    items: list[models.AtomicGenerationChunk],
+    voice_prompt: dict,
+    language: str,
+    seed: int | None,
+) -> tuple[list, int]:
+    """Generate complete items in order, bisecting only an OOM GPU batch."""
+    try:
+        return await backend.generate_batch(
